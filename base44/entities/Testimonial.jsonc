{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "quote": {
      "type": "string",
      "description": "Testimonial quote (never translated)"
    },
    "author_name": {
      "type": "string"
    },
    "author_location": {
      "type": "string"
    },
    "author_photo": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "quote",
    "author_name"
  ]
}