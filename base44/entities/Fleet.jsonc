{
  "name": "Fleet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Vehicle name e.g. Toyota Avanza"
    },
    "type": {
      "type": "string",
      "description": "e.g. SUV, Minivan, MPV"
    },
    "capacity": {
      "type": "number",
      "description": "Max passengers"
    },
    "price": {
      "type": "string",
      "description": "e.g. IDR 1,400,000"
    },
    "includes_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What's included (English)"
    },
    "includes_id": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What's included (Bahasa Indonesia)"
    },
    "terms_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Terms & conditions (English)"
    },
    "terms_id": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Terms & conditions (Bahasa Indonesia)"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Extra features e.g. AC, WiFi, Private Driver"
    },
    "image_url": {
      "type": "string"
    },
    "price_note": {
      "type": "string",
      "description": "e.g. Harga diluar tarif parkir, toll, dan tips driver"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}