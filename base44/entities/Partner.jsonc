{
  "name": "Partner",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Company/Agency name"
    },
    "pic_name": {
      "type": "string",
      "description": "Person in charge name"
    },
    "pic_phone": {
      "type": "string",
      "description": "PIC WhatsApp with country code"
    },
    "email": {
      "type": "string",
      "description": "Contact email"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    },
    "logo_url": {
      "type": "string"
    },
    "website_url": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Active partner"
    },
    "publish_on_website": {
      "type": "boolean",
      "default": false,
      "description": "Show on public website"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}