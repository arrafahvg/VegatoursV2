{
  "name": "TourPackage",
  "type": "object",
  "properties": {
    "title_en": {
      "type": "string",
      "description": "Package title in English"
    },
    "title_id": {
      "type": "string",
      "description": "Package title in Bahasa Indonesia"
    },
    "price": {
      "type": "string",
      "description": "Price display text e.g. IDR 850,000 / car"
    },
    "currency": {
      "type": "string",
      "default": "IDR"
    },
    "duration_en": {
      "type": "string",
      "description": "Duration in English"
    },
    "duration_id": {
      "type": "string",
      "description": "Duration in Bahasa Indonesia"
    },
    "highlights_en": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Highlights in English"
    },
    "highlights_id": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Highlights in Bahasa Indonesia"
    },
    "description_en": {
      "type": "string"
    },
    "description_id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "cta_text_en": {
      "type": "string",
      "default": "Book This Tour"
    },
    "cta_text_id": {
      "type": "string",
      "default": "Pesan Tur Ini"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title_en",
    "price"
  ]
}